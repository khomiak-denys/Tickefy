<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA1848: LoggerMessage source-generator is a micro-optimisation that requires
         adding 'partial' to every handler class — too noisy for this project size. -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Ticket\Reopen\" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="FluentValidation" Version="12.1.0" />
    <PackageReference Include="MediatR" Version="13.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tickefy.Domain\Tickefy.Domain.csproj" />
  </ItemGroup>

</Project>
