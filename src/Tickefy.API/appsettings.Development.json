{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console", "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { 
                "Name": "Console"
            },
            {
                "Name": "Seq",
                "Args": {
                "serverUrl": ""
                }
            }
        ],
        "Enrich": ["FromLogContext"]
    },
    "AllowedHosts": "*",
    "CorsOptions": {
        "Name": "",
        "AllowedOrigins": [],
        "AllowedMethods": [],
        "AllowedHeaders": []
    },
    "ConnectionStrings": {
        "Postgres": ""
    },
    "JwtOptions": {
        "Key": "",
        "Issuer": "",
        "Audience": "",
        "TokenValidityMins": ""
    },
    "AiOptions": {
        "ApiKey": ""
    },
    "ObjectStorage": {
        "Endpoint": "",
        "PublicEndpoint": "",
        "AccessKey": "",
        "SecretKey": "",
        "Bucket": "",
        "Region": "",
        "ForcePathStyle": true
    }
}
