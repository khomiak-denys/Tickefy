{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Micosoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console"}
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
    },
    "AllowedHosts": "*",
    "CorsOptions": {
        "Name": "",
        "AllowedOrigins": [],
        "AllowedMethods": [],
        "AllowedHeaders": []
    },
    "ConnectionStrings": {
        "Postgres": ""
    },
    "JwtOptions": {
        "Key": "",
        "Issuer": "",
        "Audience": "",
        "TokenValidityMins": ""
    },
    "AiOptions": {
        "ApiKey": ""
    }
}
